{
  "name": "easyalias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "store:build:sandbox": "APPLE_SIGNING_IDENTITY=- tauri build --bundles app --config src-tauri/tauri.sandbox.conf.json",
    "store:build": "CARGO_TARGET_DIR=/private/tmp/easyalias-appstore-target tauri build --bundles app --target universal-apple-darwin --config src-tauri/tauri.appstore.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
